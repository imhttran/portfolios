# Backend (FastAPI) — copy to .env and adjust. A personal root .env provides
# these already; this file documents every variable the app reads.

# Runtime profile: development | qa | production.
# development seeds a known admin login (admin@mail.com); qa/prod never do.
NODE_ENV=development

# PostgreSQL connection. Required. Tables apply automatically on start.
DATABASE_URL="postgres://user:password@localhost:5432/db_portfolios?sslmode=disable"

# Authentication — REQUIRED in production (the server refuses to boot
# without it); falls back to a dev-only secret otherwise.
JWT_SECRET="your-secret-key-here-change-in-production"

# Listen port for the API (the Next.js frontend lives on 3000).
PORT=8080

# email
MAIL_FROM="tom.tran@email.com"
MAX_ATTEMPTS=2
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="your-smtp-password"

# Photo files on local disk. Point this at a mounted volume, or at a temp
# directory to test a fresh boot without touching the real media tree.
# MEDIA_ROOT="/var/lib/portfolios/media"

# How long a browser stays trusted after completing 2FA, in days. Each
# verification slides it forward again.
# DEVICE_TRUST_DAYS=30

# email verification gate (login + /api/me). Leave unset to require it.
EMAIL_VERIFICATION_REQUIRED=false

# Used in verification / reset links sent by email.
FRONTEND_URL="http://localhost:3000"

# Frontend: where the Next.js server proxies /api/* to (server-side — the
# browser never talks to the API directly). Only set if the API lives
# somewhere other than http://localhost:8080.
# API_URL="http://api.internal:8080"
#
# Split-domain deployment that calls the API from the browser directly?
# Set NEXT_PUBLIC_API_URL instead (build-time, inlined into the client bundle;
# re-enable CORS in backend/app/main.py if you do this).
# NEXT_PUBLIC_API_URL="https://api.example.com"
